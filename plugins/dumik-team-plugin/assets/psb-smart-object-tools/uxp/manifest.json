{
  "manifestVersion": 5,
  "id": "com.codex.psb-smart-object-tools.uxp",
  "name": "PSB 智能对象工具",
  "version": "1.3.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "24.0.0",
    "data": {
      "apiVersion": 2
    }
  },
  "requiredPermissions": {
    "localFileSystem": "fullAccess"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "main",
      "label": {
        "default": "PSB 智能对象工具"
      },
      "minimumSize": {
        "width": 320,
        "height": 280
      },
      "preferredDockedSize": {
        "width": 360,
        "height": 450
      },
      "preferredFloatingSize": {
        "width": 380,
        "height": 450
      }
    }
  ]
}
