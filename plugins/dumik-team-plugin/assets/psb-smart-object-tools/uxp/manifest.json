{
  "manifestVersion": 5,
  "id": "com.codex.psb-smart-object-tools.uxp",
  "name": "PSB 智能对象工具",
  "version": "1.3.28",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "24.0.0",
    "data": {
      "apiVersion": 2
    }
  },
  "requiredPermissions": {
    "localFileSystem": "fullAccess"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "main",
      "label": {
        "default": "PSB 智能对象工具"
      },
      "minimumSize": {
        "width": 240,
        "height": 180
      },
      "maximumSize": {
        "width": 2000,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 420,
        "height": 420
      },
      "preferredFloatingSize": {
        "width": 720,
        "height": 680
      }
    }
  ]
}
